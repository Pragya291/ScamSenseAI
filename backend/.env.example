# ScamSense AI — Backend Environment Configuration (FastAPI)
# Copy to backend/.env for local development, or add to Render Dashboard

PROJECT_NAME="ScamSense AI — Scam & Fraud Defense Agent"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://scamsenseai.vercel.app","https://scamsense-ai.vercel.app"]

# JWT Secret
SECRET_KEY="replace-with-a-random-secure-64-character-production-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="sqlite:///./scamsense.db"

# -----------------------------------------------------------------
# EXTERNAL SECURITY & AI API KEYS
# -----------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_SAFE_BROWSING_API_KEY="your-google-safe-browsing-api-key"
VIRUSTOTAL_API_KEY="your-virustotal-api-key"
TAVILY_API_KEY="your-tavily-api-key"

# -----------------------------------------------------------------
# FIREBASE ADMIN SDK & CLOUD FIRESTORE
# -----------------------------------------------------------------
FIREBASE_PROJECT_ID="scamsenseai-8bf14"
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"
# Or stringified JSON for cloud environments (Render):
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
