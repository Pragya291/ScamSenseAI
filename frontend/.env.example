# ScamSense AI Environment Configuration Template

# Project Metadata & Server
PROJECT_NAME="ScamSense AI — Scam & Fraud Defense Agent"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
FRONTEND_URL="http://localhost:5173"

# Security & Authentication (JWT)
SECRET_KEY="your-super-secret-jwt-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL="sqlite:///./scamsense.db"

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# -----------------------------------------------------------------
# EXTERNAL SECURITY & AI API KEYS (Add your API keys below)
# -----------------------------------------------------------------

# 1. Google Gemini AI API (Required for Generative LLM Scam Analysis)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# 2. Google Safe Browsing API (URL Phishing & Malware Check)
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_API_KEY="AIzaSy..."

# 3. VirusTotal API v3 (URL Security Engine Breakdown)
# Get your key at: https://www.virustotal.com/gui/user/apiKey
VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# 4. Tavily Search API (Optional Web Research Threat Evidence)
# Get your key at: https://tavily.com/
TAVILY_API_KEY="tvly-..."

# -----------------------------------------------------------------
# FIREBASE ADMIN SDK & CLOUD FIRESTORE (Backend Configuration)
# -----------------------------------------------------------------

# Firebase Console: https://console.firebase.google.com/
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CREDENTIALS_PATH="path/to/serviceAccountKey.json"

# -----------------------------------------------------------------
# FIREBASE WEB CLIENT CONFIGURATION (Frontend Vite Configuration)
# -----------------------------------------------------------------

VITE_FIREBASE_API_KEY="your-firebase-client-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
