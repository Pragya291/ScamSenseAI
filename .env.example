# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Optional Third-Party Services Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
