# ScamSenseAI Configuration Template

# Project Metadata
PROJECT_NAME="ScamSenseAI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment & Debug
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
SECRET_KEY="your-super-secret-jwt-key-here"
ALGORITHM="HS256"
