VITE_FIREBASE_API_KEY="AIzaSyBOVeDV9qpO-ablYz524ECn1hIXyIMhqIk"
VITE_FIREBASE_AUTH_DOMAIN="scamsenseai-8bf14.firebaseapp.com"
