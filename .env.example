# =================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Railway / Docker / Server)
# Configure these in your backend host (Render dashboard -> Environment)
# =================================================================

PROJECT_NAME="ScamSense AI — Scam & Fraud Defense Agent"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False

# Allowed Frontend Origins (CORS)
# Add your deployed Vercel domain and custom domains
FRONTEND_URL="https://scamsenseai.vercel.app"
CORS_ORIGINS=["https://scamsenseai.vercel.app","https://scamsense-ai.vercel.app","http://localhost:5173","http://localhost:3000"]

# Backend JWT Security Secret (generate random secure string for production)
SECRET_KEY="replace-with-a-random-secure-64-character-production-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL (SQLite default or PostgreSQL)
DATABASE_URL="sqlite:///./scamsense.db"

# -----------------------------------------------------------------
# EXTERNAL SECURITY & AI API KEYS
# -----------------------------------------------------------------

# 1. Google Gemini AI API (Generative explainable fraud reasoning)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."

# 2. Google Safe Browsing API v4 (Phishing & malware URL intelligence)
# Obtain at: https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_API_KEY="AIzaSy..."

# 3. VirusTotal API v3 (Multi-engine antivirus & reputation verification)
# Obtain at: https://www.virustotal.com/gui/user/apiKey
VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# 4. Tavily Search API (Threat research evidence extraction)
# Obtain at: https://tavily.com/
TAVILY_API_KEY="tvly-..."

# -----------------------------------------------------------------
# FIREBASE ADMIN SDK & CLOUD FIRESTORE
# -----------------------------------------------------------------
FIREBASE_PROJECT_ID="scamsenseai-8bf14"

# Optional path to service account key file (if hosted on disk):
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"

# OR full JSON content of serviceAccountKey.json as a string (ideal for Render/Railway):
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"scamsenseai-8bf14",...}'
